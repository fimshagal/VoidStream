{
  "name": "voidstream",
  "private": true,
  "version": "0.1.0",
  "description": "Black-box entropy library powered by open data sources (NASA, USGS, etc.) and local context.",
  "type": "module",
  "main": "./dist/lib/voidstream.cjs",
  "module": "./dist/lib/voidstream.js",
  "types": "./dist/lib/types/index.d.ts",
  "unpkg": "./dist/lib/voidstream.umd.cjs",
  "jsdelivr": "./dist/lib/voidstream.umd.cjs",
  "exports": {
    ".": {
      "types": "./dist/lib/types/index.d.ts",
      "import": "./dist/lib/voidstream.js",
      "require": "./dist/lib/voidstream.cjs",
      "default": "./dist/lib/voidstream.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/lib",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "build:demo": "vite build",
    "build": "npm run typecheck && npm run build:lib && npm run build:demo",
    "preview": "vite preview --outDir dist/demo"
  },
  "devDependencies": {
    "javascript-obfuscator": "^5.4.3",
    "typescript": "~5.6.3",
    "vite": "^5.4.10"
  }
}
